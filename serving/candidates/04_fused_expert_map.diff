+++ b/python/sglang/kernels/ops/moe/map_marlin_expert_ids.py
@@ -0,0 +1,40 @@
+"""Fuse Marlin's int32 route cast, local mapping and drop-sentinel selection."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _map_kernel(ids, mapping, out, N: tl.constexpr, BLOCK: tl.constexpr):
+    offset = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    live = offset < N
+    # Match the original cast before indexing, including int64 wraparound.
+    expert = tl.load(ids + offset, live, other=-1).to(tl.int32)
+    mapped = tl.load(mapping + expert, live & (expert >= 0), other=-1)
+    tl.store(out + offset, mapped, live)
+
+
+def map_marlin_expert_ids(ids: torch.Tensor, mapping: torch.Tensor) -> torch.Tensor:
+    """Return contiguous int32 IDs; valid nonnegative routes index ``mapping``.
+
+    Negative IDs all become -1. As with the stock router and gather, nonnegative
+    IDs must be within the global expert vocabulary. Scratch is per invocation.
+    """
+    if (
+        ids.is_cuda
+        and ids.dtype in (torch.int32, torch.int64)
+        and ids.is_contiguous()
+        and mapping.is_contiguous()
+        and mapping.ndim == 1
+        and mapping.dtype == torch.int32
+        and ids.device == mapping.device
+    ):
+        out = torch.empty_like(ids, dtype=torch.int32)
+        if ids.numel():
+            _map_kernel[(triton.cdiv(ids.numel(), 256),)](
+                ids, mapping, out, ids.numel(), 256
+            )
+        return out
+    cast = ids.to(torch.int32)
+    return torch.where(cast < 0, -1, mapping[cast.clamp_min(0)]).contiguous()
